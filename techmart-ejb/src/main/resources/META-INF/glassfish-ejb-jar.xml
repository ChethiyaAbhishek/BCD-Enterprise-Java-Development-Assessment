<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-ejb-jar PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 EJB 3.1//EN"
        "http://glassfish.org/dtds/glassfish-ejb-jar_3_1-1.dtd">
<glassfish-ejb-jar>
    <enterprise-beans>
        <ejb>
            <ejb-name>OrderProcessingBean</ejb-name>
            <pool>
                <pool-resize-quantity>10</pool-resize-quantity>
                <pool-idle-timeout-in-seconds>300</pool-idle-timeout-in-seconds>
            </pool>
        </ejb>
        <ejb>
            <ejb-name>ProductServiceBean</ejb-name>
            <pool>
                <pool-resize-quantity>20</pool-resize-quantity>
                <pool-idle-timeout-in-seconds>300</pool-idle-timeout-in-seconds>
            </pool>
        </ejb>
    </enterprise-beans>
</glassfish-ejb-jar>